# Copy this file to ".env" locally. Never commit .env — it stays gitignored.
# See README or Google Cloud Console for OAuth credentials on your chosen GCP project.

DATABASE_URL="file:./prisma/dev.db"

# Required for Auth.js: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (APIs & Services → Credentials → OAuth 2.0 Client ID → Web application)
# Create these in the same GCP project you use for this app (e.g. Console project picker).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_TRUST_HOST="true"

# Optional (production URL for callbacks / links)
# NEXTAUTH_URL="http://localhost:3000"

# Google Cloud: create or pick a project in Console, then create OAuth credentials there.
# Project IDs are not secrets; OAuth client id/secret still belong only in .env locally.
