generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  reportFiles   ReportFile[]
  measurements  LabMeasurement[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ReportFile {
  id           String   @id @default(cuid())
  userId       String
  originalName String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  reportDate   DateTime
  createdAt    DateTime @default(now())
  parseNote    String?
  rawTextHash  String?

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  measurements LabMeasurement[]

  @@index([userId, reportDate])
}

model LabMeasurement {
  id            String   @id @default(cuid())
  userId        String
  reportFileId  String
  parameterKey  String
  value         Float
  unit          String
  measuredAt    DateTime
  matchAlias    String
  sourceSnippet String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportFile ReportFile @relation(fields: [reportFileId], references: [id], onDelete: Cascade)

  @@index([userId, parameterKey, measuredAt])
  @@index([reportFileId])
}
